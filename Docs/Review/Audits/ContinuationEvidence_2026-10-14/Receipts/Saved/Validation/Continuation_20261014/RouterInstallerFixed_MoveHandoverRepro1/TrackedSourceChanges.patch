+        if (!Original.Contains(Edge) && Schema->CanCreateConnection(Edge.Output(), Edge.Input()).Response == CONNECT_RESPONSE_DISALLOW) return false;
+    }
+    const bool bWasDirty = Blueprint->GetOutermost()->IsDirty();
