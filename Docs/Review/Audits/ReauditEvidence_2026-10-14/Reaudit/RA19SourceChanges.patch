+void UProject_JWeaponPresentationComponent::EnterCombatPresentation()
+{
+	bCombatPresentationActive = true;
+	UE_LOG(LogProjectJWeaponPresentation, Verbose, TEXT("EnterCombatPresentation: Owner=%s"), *GetNameSafe(GetOwner()));
