-
-	if (bFlushTap)
-	{
-		if (UWorld* World = GetWorld())
-		{
-			World->GetTimerManager().ClearTimer(PendingChordTimerHandle);
-		}
-		bHasPendingChordButton = false;
-		// A quick tap should not pay the full grace-period delay.
-		DispatchButtonInputTag(Button, TapTag);
