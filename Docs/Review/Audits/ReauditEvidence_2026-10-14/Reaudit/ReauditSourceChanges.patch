+uint64 UProject_JWeaponPresentationComponent::BeginGroundContactNotify()
+{
+	if (bEndingPlay || IsBeingDestroyed()) return 0;
+	const uint64 Token = ++NextGroundContactNotifyToken;
+	GroundContactNotifyTokens.Add(Token);
+	return Token;
+}
