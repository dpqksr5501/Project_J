+void UProject_JWeaponPresentationComponent::AttachWeaponToSheathedSocket()
+{
+	EndIndependentMotion();
+
+	const UProject_JWeaponPresentationProfile* PresentationProfile = GetCurrentPresentationProfile();
+	if (!SpawnedWeapon)
+	{
+		RefreshPresentation();
