+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Locomotion|Presentation|Lean", meta = (ClampMin = "0.0", Units = "cm/s"))
+	float SprintLeanMinSpeedThreshold = 550.0f;
+};
